# Copy to .env.local and fill in. Everything here has a free tier.

# HouseCall Pro: Settings → App Store → API → Generate API key (needs the MAX plan).
# Optional if Turso is set: quotes are always saved there first. With neither set, quotes are
# only logged to the terminal in dev and rejected in production.
HOUSECALL_PRO_API_KEY=

# Database: https://turso.tech (free plan, no card). Every quote, item and photo link is saved here.
# Create a database, then: turso db show <name> --url  and  turso db tokens create <name>
# (or copy both from the dashboard). Tables are created automatically on the first quote.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Customer photos: https://cloudinary.com/users/register_free (free plan, no card).
# Dashboard → Settings → API Keys. Without these, the photo buttons are hidden and photos aren't required.
# With them, customers must take/upload at least one photo per item.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Address autocomplete: https://myprojects.geoapify.com (free: 3,000 lookups/day, no card).
# Optional. Without it, the free keyless Photon service is used (fine for low traffic).
GEOAPIFY_API_KEY=

# Any long random string. Signs autocomplete results so only real, picked addresses are accepted.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADDRESS_SIGNING_SECRET=

# Public site URL, used for canonical links, sitemap.xml and structured data. Defaults to the line below.
NEXT_PUBLIC_SITE_URL=https://moversandjunkremoval.net
